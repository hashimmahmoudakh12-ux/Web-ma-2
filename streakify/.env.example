# Copy this file to .env.local and fill it in. NEVER commit .env.local.

# The domain your app lives on. Locally: localhost:3000. On Vercel: streakify.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase -> Project Settings -> API. Leave empty to run with in-memory demo data.
SUPABASE_URL=
# The "service_role" secret key. Server-only: never put it in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Random string, at least 32 characters, used to sign the counter-tablet cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
