# Copy to .env.local (on your computer) or add in Vercel -> Settings -> Environment Variables.
# NEVER commit real values.

# ---- Required in production -------------------------------------------------
# Your domain. Locally: localhost:3000. On Vercel: streakify.com (or your-app.vercel.app)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Supabase -> Project Settings -> API
SUPABASE_URL=
# Same URL again + the "anon public" key: used for owner/admin logins (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" secret key. Server-only: NEVER put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Demo mode only (no Supabase): the demo admin login. With Supabase, run
# `npm run create-admin -- you@email.com` instead (see README).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Protects the daily job URL. Vercel sends it automatically to /api/cron/daily.
CRON_SECRET=

# Demo without a database: set to true to allow in-memory data in production (pitch demos only)
ALLOW_MEMORY_DB=

# ---- Phase 4: monthly report emails (resend.com) ---------------------------
RESEND_API_KEY=
REPORT_FROM_EMAIL=

# ---- Phase 5: text reminders (twilio.com) -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number (+1...) or a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The exact public URL Twilio posts to, e.g. https://streakify.com/api/twilio/inbound
TWILIO_WEBHOOK_URL=

# ---- Phase 6: Toast POS ------------------------------------------------------
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# Defaults to https://ws-api.toasttab.com (use Toast's sandbox host while testing)
TOAST_API_HOST=

# ---- Home-screen app push notifications -------------------------------------
# Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ---- Apple Wallet (needs an Apple Developer account) ------------------------
# See src/lib/wallet/apple.ts for how to make these. Certificates are base64 of the PEM files.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# ---- Google Wallet ------------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
# Service-account JSON key file, base64-encoded on one line
GOOGLE_WALLET_SERVICE_ACCOUNT=
