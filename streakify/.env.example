# Copy to .env.local (on your computer) or add in Vercel -> Settings -> Environment Variables.
# NEVER commit real values.

# ---- Required in production -------------------------------------------------
# Your domain. Locally: localhost:3000. On Vercel: streakify.com (or your-app.vercel.app)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Supabase -> Project Settings -> API (service_role key is server-only; never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Password for YOUR admin page (/admin). In local dev the default is "admin".
ADMIN_PASSWORD=
# Protects the daily job URL. Vercel sends it automatically to /api/cron/daily.
CRON_SECRET=

# Demo without a database: set to true to allow in-memory data in production (pitch demos only)
ALLOW_MEMORY_DB=

# ---- Phase 4: monthly report emails (resend.com) ---------------------------
RESEND_API_KEY=
REPORT_FROM_EMAIL=

# ---- Phase 5: text reminders (twilio.com) -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number (+1...) or a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The exact public URL Twilio posts to, e.g. https://streakify.com/api/twilio/inbound
TWILIO_WEBHOOK_URL=

# ---- Phase 6: Toast POS ------------------------------------------------------
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# Defaults to https://ws-api.toasttab.com (use Toast's sandbox host while testing)
TOAST_API_HOST=
